# WeSleep - Environment Configuration Example

# Name of the project (used in API responses)
PROJECT_NAME=WeSleep_Dev

# Base URL prefix for API endpoints
API_V1_STR=/api/v1

# Database Connection String
# For PostgreSQL (Supabase): postgresql+asyncpg://user:pass@host:port/db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wesleep

# Groq API Key — free tier (Llama 3.3 70B for sleep reasoning)
GROQ_API_KEY=your_groq_api_key_here
